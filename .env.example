# PostgreSQL — URL Prisma, à remplacer par vos propres informations.
DATABASE_URL="postgresql://memoria:mot_de_passe_local@localhost:5432/memoria?schema=public"

# URL canonique utilisée pour les liens e-mail et l’authentification.
APP_URL="http://localhost:3000"

# Secret aléatoire d’au moins 32 caractères. Générer séparément pour chaque environnement :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# SMTP requis pour vérifier les adresses et réinitialiser les mots de passe.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="MEMORIA"

# Promotion facultative d’un compte déjà inscrit vers le rôle administrateur.
SEED_ADMIN_EMAIL=""
